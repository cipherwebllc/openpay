# ==========================================================================
# OpenPay 環境変数
# このファイルを `.env.local` にコピーして値を埋めてください。
# ==========================================================================
#
# Vercel 上での運用に関する重要な注意:
#   全ての NEXT_PUBLIC_* はクライアントバンドルに展開されるため公開情報。
#   Vercel Dashboard では "Plain" (= non-sensitive) で問題なし。
#   逆に Sensitive (暗号化) フラグが必要なのは下方の SENTRY_AUTH_TOKEN だけ。
#   詳細は README "Vercel デプロイ" セクション参照。
# ==========================================================================

# mainnet | testnet
#   mainnet => Base + Arbitrum + Optimism + Polygon
#   testnet => Base Sepolia + Arbitrum Sepolia + Optimism Sepolia + Polygon Amoy
NEXT_PUBLIC_NETWORK_ENV=testnet

# Pimlico ダッシュボード (https://dashboard.pimlico.io) で取得
# 重要: 本番デプロイ時は Origin (ドメイン) 制限を必ず設定すること。
# Vercel Plain で OK (元々クライアントに露出する設計)。
NEXT_PUBLIC_PIMLICO_API_KEY=

# Pimlico の Sponsorship Policy ID (例: sp_xxxxxxxx)
# 各 EVM チェーン共通で使えるポリシーを 1 つ作成して指定
# 未指定の場合はアカウント既定ルールに従う
NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY_ID=

# 1% 手数料の受取アドレス (運営アドレス)
# 未設定時は 0x...dEaD にフォールバック (本番環境では必ず設定すること)
NEXT_PUBLIC_FEE_RECEIVER_ADDRESS=

# WalletConnect Cloud (https://cloud.reown.com) で取得した projectId
NEXT_PUBLIC_WC_PROJECT_ID=

# 任意: 各チェーンの RPC URL。Alchemy/Infura など。
# Alchemy/Infura key はクライアントから叩く設計上クライアントに露出するため
# Vercel Plain で OK。Origin 制限は Alchemy/Infura ダッシュボードで設定する。
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_ARBITRUM_RPC_URL=
NEXT_PUBLIC_OPTIMISM_RPC_URL=
NEXT_PUBLIC_POLYGON_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_OPTIMISM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL=

# Kaia 用 RPC (JPYC Kaia PoC、kaia-poc branch でのみ使用)。
# 未設定なら viem default RPC (kaiarpc.io 等) にフォールバック。
NEXT_PUBLIC_KAIA_RPC_URL=
NEXT_PUBLIC_KAIROS_RPC_URL=

# Ethereum L1 用 RPC (phase 4a で USDC merchant 受信 chain 追加、SBI VC トレード等
# 出庫先が Ethereum L1 限定のユースケース対応)。public RPC は rate limit に弱いため
# production では Alchemy / Infura 等の有料 RPC 推奨。env 名は ENS 解決用の
# NEXT_PUBLIC_MAINNET_RPC_URL と別系統 (use case が異なるため URL 値は同じでも問題なし)。
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Avalanche C-Chain / Unichain 用 RPC (phase 4b-1 で buyer-only chain 追加、
# USDC global volume + 国内 CEX 引出先カバー)。merchant 受信 chain として
# UI には露出しないが、buyer wallet が当該 chain に繋がった場合の
# balance fetch / Gateway burn sign で必要。viem/chains default RPC でも
# 動くが、production では Alchemy / Ankr 等の override 推奨。
NEXT_PUBLIC_AVALANCHE_RPC_URL=
NEXT_PUBLIC_AVALANCHE_FUJI_RPC_URL=
NEXT_PUBLIC_UNICHAIN_RPC_URL=
NEXT_PUBLIC_UNICHAIN_SEPOLIA_RPC_URL=

# 追加 buyer-only chain (Worldchain / Sonic / Sei / HyperEVM)。merchant 受信 chain には
# 出さないが、buyer wallet が当該 chain の場合の balance fetch / Gateway burn に必要。
# 未設定なら viem/chains default RPC にフォールバック (production は override 推奨)。
NEXT_PUBLIC_WORLDCHAIN_RPC_URL=
NEXT_PUBLIC_WORLDCHAIN_SEPOLIA_RPC_URL=
NEXT_PUBLIC_SONIC_RPC_URL=
NEXT_PUBLIC_SONIC_TESTNET_RPC_URL=
NEXT_PUBLIC_SEI_RPC_URL=
NEXT_PUBLIC_SEI_TESTNET_RPC_URL=
NEXT_PUBLIC_HYPEREVM_RPC_URL=
NEXT_PUBLIC_HYPEREVM_TESTNET_RPC_URL=

# 任意: ENS / Basenames 名前解決用の mainnet RPC。
# 既定: https://ethereum-rpc.publicnode.com (CCIP-Read 対応)
# 本番では Alchemy / Infura 等の有料 RPC を推奨 (CCIP-Read 必須)。
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=

# 任意: ログレベル (debug | info | warn | error)。既定は warn。
NEXT_PUBLIC_LOG_LEVEL=warn

# 必須 (mainnet): Sentry DSN。Replay (10% / エラー時 100%) も自動有効化。
# DSN は公開前提の設計。Vercel Plain で OK。
# 未設定で mainnet build を試みると lib/env.ts:287 で deploy 中止される
# (browser 観測ゼロ防止)。testnet では任意。
NEXT_PUBLIC_SENTRY_DSN=

# 任意: Sentry sampling 調整 (0.0〜1.0、不正値は既定にフォールバック)。
# 既定は traces=1.0 / replay=0.1 / replay-on-error=1.0。
# トラフィック増加でコスト spike した場合に再デプロイなしで絞れるよう env 化。
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=

# !!! Sensitive: Vercel Dashboard で必ず "Sensitive" フラグを付けて登録すること !!!
# Sentry CLI が build 時に source map をアップロードするための token。
# 漏洩すると source map のアップロード/上書き権限を取られる。
# 2026-04 の Vercel インシデントでは Sensitive 化されていない env vars が
# 漏洩対象になったため、本 token は必ず Sensitive で保管。
# .env.local (ローカル) では平文で良い、Vercel 環境のみ Sensitive。
SENTRY_AUTH_TOKEN=

# 任意: testnet 環境で実トークンが無い場合に独自 ERC20 のアドレスを上書き指定
# JPYC Polygon testnet (Amoy) は real な JPYC 未 deploy のため placeholder
# (mainnet と同 address) を default に置く。dev/test 用の dummy ERC20 への
# 切替は env で。
# JPYC Kaia testnet (Kairos) は JPYC 公式 Kairos faucet 経由で real な JPYC が
# 入手可能 (2026-05-18 対応)。hard-code default で動作するため env 不要、
# emergency address 変更時のみ override 用途で設定。
NEXT_PUBLIC_JPYC_TESTNET_ADDRESS=0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29
NEXT_PUBLIC_JPYC_KAIROS_ADDRESS=
# Avalanche Fuji の JPYC (NEXT_PUBLIC_ENABLE_JPYC_AVALANCHE=1 時)。hard-code default = 同一アドレス
# (0xE7C3…・2026-06-15 verify-jpyc-eip3009.mjs で EIP-3009/domain 実機確認済)。emergency override 用。
NEXT_PUBLIC_JPYC_AVALANCHE_FUJI_ADDRESS=

# USDC は対応 5 chain (phase 4a で Ethereum L1 追加) それぞれで上書き可能
# (Circle native USDC アドレス変更や testnet カスタム ERC20 への切替に対応)。
# 既定は Circle 公式アドレス。
NEXT_PUBLIC_USDC_BASE_SEPOLIA_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_USDC_ARBITRUM_SEPOLIA_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
NEXT_PUBLIC_USDC_OPTIMISM_SEPOLIA_ADDRESS=0x5fd84259d66Cd46123540766Be93DFE6D43130D7
NEXT_PUBLIC_USDC_POLYGON_AMOY_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
NEXT_PUBLIC_USDC_SEPOLIA_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# phase 4b-1 (buyer-only chain): merchant 受信 chain には出ないが
# CrossChainHint が buyer balance を引く際に address 解決に必要。
NEXT_PUBLIC_USDC_AVALANCHE_FUJI_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
NEXT_PUBLIC_USDC_UNICHAIN_SEPOLIA_ADDRESS=0x31d0220469e10c4E71834a79b1f276d740d3768F

# 任意: mainnet トークンアドレスの上書き
# JPYC v3 (改正資金決済法・電子決済手段) の既定値が古い可能性に備えて、必ず
# 公式ソースで確認してください。不一致が見つかった場合はこの env で上書きしてください。
NEXT_PUBLIC_JPYC_MAINNET_ADDRESS=

# Kaia mainnet (chainId 8217) 上の JPYC contract address。
# default hard-code = 0xE7C3D8C9a439feDe00D2600032D5dB0Be71C3c29 (2026-05-15 JPYC
# 公式 deploy、scripts/verify-kaia-jpyc.mjs で実機 verify 済)。env で値を入れる
# と hard-code を上書き (emergency address 変更用)、空 / 未設定なら hard-code が
# そのまま動作する safe-by-default 設計。
NEXT_PUBLIC_JPYC_KAIA_ADDRESS=
# Avalanche mainnet (chainId 43114) の JPYC。hard-code default = 0xE7C3… (2026-06-15 実機 verify 済)。
# NEXT_PUBLIC_ENABLE_JPYC_AVALANCHE=1 時に有効。emergency address 変更用 override (空=hard-code)。
NEXT_PUBLIC_JPYC_AVALANCHE_MAINNET_ADDRESS=
# Ethereum L1 mainnet (chainId 1) の JPYC。hard-code default = 0xE7C3… (実機 verify 済: JPY Coin/JPYC/18)。
# NEXT_PUBLIC_ENABLE_JPYC_ETHEREUM=1 時に有効 (standard モード固定・下記フラグ参照)。空=hard-code。
NEXT_PUBLIC_JPYC_ETHEREUM_MAINNET_ADDRESS=
# Ethereum L1 は mainnet 限定 (JPYC は Sepolia 未 deploy)。この testnet override は型完全性のための
# プレースホルダで実際には使われない (空のままで良い)。
NEXT_PUBLIC_JPYC_ETHEREUM_SEPOLIA_ADDRESS=

# USDC mainnet は 5 chain (phase 4a で Ethereum L1 追加) それぞれで上書き可能。
# 既定は Circle native USDC アドレス。bridged USDC.e (Wormhole / PoS bridge 経由) は
# **非対応** — 必ず native USDC を指定。
# 注: Ethereum L1 USDC は Pimlico ERC20 paymaster 未対応のため gasless 不可、
# standard mode のみ動作 (URL parser が mode=gasless+chain=ethereum を reject)。
NEXT_PUBLIC_USDC_BASE_MAINNET_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDC_ARBITRUM_MAINNET_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
NEXT_PUBLIC_USDC_OPTIMISM_MAINNET_ADDRESS=0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85
NEXT_PUBLIC_USDC_POLYGON_MAINNET_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
NEXT_PUBLIC_USDC_ETHEREUM_MAINNET_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# phase 4b-1 mainnet (buyer-only chain): USDC global volume + 国内 CEX 引出先
# カバー。merchant 受信 chain には出さない (USDC_CHAINS は 5 のまま)、
# CrossChainHint balance fetch + Gateway source としてのみ使用。
NEXT_PUBLIC_USDC_AVALANCHE_MAINNET_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
NEXT_PUBLIC_USDC_UNICHAIN_MAINNET_ADDRESS=0x078D782b760474a361dDA0AF3839290b0EF57AD6

# 追加 buyer-only chain (Worldchain / Sonic / Sei / HyperEVM) の USDC。既定は lib/tokens の
# hard-code (Circle native USDC) で動作するため通常は空でよい。emergency address 変更時のみ override。
# 必ず native USDC を指定 (bridged USDC.e は非対応)。
NEXT_PUBLIC_USDC_WORLDCHAIN_MAINNET_ADDRESS=
NEXT_PUBLIC_USDC_WORLDCHAIN_SEPOLIA_ADDRESS=
NEXT_PUBLIC_USDC_SONIC_MAINNET_ADDRESS=
NEXT_PUBLIC_USDC_SONIC_TESTNET_ADDRESS=
NEXT_PUBLIC_USDC_SEI_MAINNET_ADDRESS=
NEXT_PUBLIC_USDC_SEI_TESTNET_ADDRESS=
NEXT_PUBLIC_USDC_HYPEREVM_MAINNET_ADDRESS=
NEXT_PUBLIC_USDC_HYPEREVM_TESTNET_ADDRESS=

# 任意: 「最大ガス代」見積に使う UserOp gas 単位 (整数)。
# default: USDC erc20 経路 500_000 / JPYC sponsorship 経路 200_000。
# env で override すると両 token に同値が適用される (token 別 override は実装なし)。
# 値が小さすぎると USDC erc20 で approve allowance 不足 → postOp revert、
# JPYC sponsorship で gas 過小評価 → 運営マージン目減りリスク。本番計測後に調整。
NEXT_PUBLIC_GAS_QUOTE_OVERHEAD_GAS=

# 任意: チェーン別 gas price 上限 (gwei、整数)。
# 既定: Polygon 200 / Base 1 / Arbitrum 1 / Optimism 1。
# 運用フェーズで Sentry の gas_congested シグナルを見て再デプロイなしで調整。
NEXT_PUBLIC_GAS_CEILING_POLYGON_GWEI=
NEXT_PUBLIC_GAS_CEILING_BASE_GWEI=
NEXT_PUBLIC_GAS_CEILING_ARBITRUM_GWEI=
NEXT_PUBLIC_GAS_CEILING_OPTIMISM_GWEI=
# Kaia mainnet 既定 50 gwei (Pimlico fast 実測前の安全側初期値、公式「1 円未満」想定)。
# Kairos testnet は default 1000 gwei (緩く)。本投入後に実測値で tune。
NEXT_PUBLIC_GAS_CEILING_KAIA_GWEI=

# 任意: JPYC Sponsorship mode で chain native (POL / KAIA) gas を JPYC へ換算する
# 固定レート (1 native = N JPYC、整数)。JPYC = JPY 1:1。月次手動更新を想定、外部 API
# 依存を持たない設計。設定漏れ時は useGasQuoteJpyc 内の chain 別 hard-code default
# (POL=20 / KAIA=10) にフォールバック。
#
# - POL は 2026-05-23 実勢 ¥14.6/POL + DEPLOY_CHECKLIST §9.5b の +37% over-collect
#   政策で既定 20 (POL は履歴的に $0.30-$1.00 まで戻る volatility あり、buffer 厚め)
# - KAIA は 2026-05-23 実勢 ¥8.21/KAIA + DEPLOY_CHECKLIST §9.5b の +22%
#   over-collect 政策で既定 10
# drift 監視 + env 更新手順は同 §9.5b。native 急騰時はこの値を上げて運営の赤字を回避。
NEXT_PUBLIC_POL_JPYC_RATE=
NEXT_PUBLIC_KAIA_JPYC_RATE=

# ==========================================================================
# alpha 取引 log (Vercel KV / Upstash Redis)
# /api/log/payment が成功・失敗時の userOp/tx を LPUSH で蓄積する。
# 弁護士 review / 金融庁 事前相談 / GMV 集計に使用。
# 未設定でも UI は動作する (Vercel runtime log のみに記録される graceful degrade)。
#
# Vercel ダッシュボード → Storage → KV (Upstash Redis) を作成 → Project に link
# すると以下 2 つが自動 inject される。手動運用なら Upstash console から発行。
# クライアント側に露出させないため NEXT_PUBLIC_ を付けないこと。
# ==========================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=

# auth / resource write の best-effort IP rate limit 用 HMAC secret (server-only)。
# `openssl rand -base64 32` で生成。未設定または 32 byte 未満なら IP limiter は skip (fail-open)。
# self-host は trusted proxy が外部入力の X-Forwarded-For を上書きする構成を前提とする。
IP_HASH_SECRET=

# log を export する管理用 endpoint (/api/log/payment/export) の Bearer 秘密鍵。
# 強い random 文字列を生成し Vercel 環境変数の Sensitive で保存。
# `curl -H "Authorization: Bearer xxxx" https://open-pay.jp/api/log/payment/export`
# で全 entry を取り出せる。
PAYMENT_LOG_ADMIN_TOKEN=

# 運営 (OpenPay 自社) 専用 admin 画面 (/admin/billing = a1 利用料の収益確認 + freee CSV + 支払い照合) を
# 開ける管理者ウォレット。カンマ区切りで複数可 (小文字/checksum どちらでも)。**空/未設定 = 全拒否 (fail-closed)**。
# SIWE でこのアドレスにサインインしたときだけ /api/admin/* が 200。NEXT_PUBLIC は付けない (server 専用)。
# 例: ADMIN_WALLETS=0xYourAdminWallet1,0xYourAdminWallet2
ADMIN_WALLETS=

# ==========================================================================
# SIWE ログイン + freee 自動連携 + 収益化ゲート (KV 必須)
# ==========================================================================
# SIWE (Sign-In With Ethereum): 店主を wallet 署名で一意識別し、freee トークンを
# 紐付ける。新たな秘密鍵は不要 (KV にランダム cookie トークン → セッションを保存)。
# 上記 KV_REST_API_URL/TOKEN が設定されていれば動作する (未設定なら /api/auth/siwe/* は 503)。
#
# SIWE の domain 束縛は **サーバ制御の許可リスト**で検証する (Host ヘッダは偽装可能なので
# 使わない = phishing replay 防止)。canonical 本番 host (lib/legal の open-pay.jp) は常に許可。
# preview/別ドメインを足す場合のみカンマ区切りで列挙 (開発時は localhost が自動許可)。
SIWE_ALLOWED_DOMAINS=
#
# freee 開発者アプリ (https://app.secure.freee.co.jp/developers/applications):
#   1. アプリ作成 → スコープ「会計 (read, write)」
#   2. コールバック URL に本番 https://<domain>/api/freee/callback と
#      開発 http://localhost:3000/api/freee/callback を登録
#   3. 発行された Client ID / Secret を以下に設定 (NEXT_PUBLIC_ は付けない = サーバ専用)。
#      審査は 20 事業所までは不要 (アルファはこの範囲で運用)。
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
FREEE_REDIRECT_URI=
# Server-only token encryption key (32 bytes as 64-char hex or base64); required when NEXT_PUBLIC_ENABLE_FREEE_SYNC is on.
FREEE_TOKEN_ENC_KEY=

# 収益化ゲート: freee 連携など周辺機能を「30日 利用権」(wallet 紐付・KV TTL) で課金する。
# **アルファ中は全開放** (既定 true)。利用権必須運用に切替えるときだけ '0' / 'false' を設定。
# コア受取 (決済) は常に無料 — ゲート対象は freee sync など付加価値機能のみ。
ALPHA_ENTITLEMENT_BYPASS=

# 旧 NEXT_PUBLIC_ENABLE_BILLING (¥4,980/年 の会計CSV利用権ゲート) は 2026-06-09 に退役。
# 履歴ぼかし/CSVロックは下記 a1「OpenPay 利用料」(NEXT_PUBLIC_ENABLE_USAGE_FEE) の延滞ゲートに一本化した
# (将来の Pro tier 基本料は a1 に上乗せして再導入予定)。このフラグはもう存在しない。

# freee 自動連携パネル (/history の SIWE ログイン + 「freee に同期」) の有効化フラグ。
# **既定 OFF (dark ship)**。会計 API の形が実プラン freee で未検証のうちは本番で出さない。
# kill-switch も兼ねる (問題時に空/未設定でパネル即非表示)。OFF でも CSV 書き出しは使える。
# ローカルで freee 連携を試すには '1' を設定。クライアント露出する判定なので NEXT_PUBLIC_。
NEXT_PUBLIC_ENABLE_FREEE_SYNC=

# ==========================================================================
# OpenPay 利用料 (a1・月次・出来高連動) — 本命の収益化モデル
# ガスレス中継した決済額の 1% を、店主が翌月に 1 署名で支払う。未払いならガスレス中継を停止する
# (standard モード = 客が自分でガス負担、は無料のまま動く)。下の recover モード (forwarder) とは**排他**
# (両方有効だと二重課金 + recover が利用料ゲート/メーターを迂回する)。a1 を点灯する chain では forwarder
# を設定しないこと。設計: docs/plans/merchant-gasless-fee-a1.md / 手順: docs/runbooks/a1-usage-fee-testnet-e2e.md
# ==========================================================================
# a1 の有効化フラグ (client 露出)。'1'/'true' で 請求 UI (/billing)・relay 関所ゲート・清算 API が起動。
# **既定 OFF** = /api/billing/* は 404・relay ゲートも inert・OpenPayFeePanel は「無料」表示で挙動不変。
# 本番点灯 = 本フラグ '1' + ALPHA_ENTITLEMENT_BYPASS=0 + OPENPAY_USAGE_FEE_START_PERIOD 設定。
NEXT_PUBLIC_ENABLE_USAGE_FEE=
# 料率 (bps・サーバ専用)。空 = 既定 100 = 1%。
OPENPAY_USAGE_FEE_BPS=
# 課金を開始する月 'YYYY-MM' (サーバ専用)。**未設定 = 全期間 0%** (安全側・既定 inert)。
# この月**以降**の取引が課金対象。例 '2026-07' で 7月の取引から 1%・8/1 に初回徴収。
# ※ 清算と関所は常に「前月」を見るので、testnet テスト時は過去日付 (例 '2020-01' = 全期間 1%) を使う。
OPENPAY_USAGE_FEE_START_PERIOD=

# @handle 恒久クリエイターリンク (open-pay.jp/@alice) の有効化フラグ (client 露出)。'1'/'true' で ON。
# **既定 OFF** = /@handle ページ・/api/handle/* ・dashboard の claim UI すべて inert (404/非表示)。
# 要 KV (KV_REST_API_URL/TOKEN)。staged rollout 用 — testnet + モデレーション体制確認後に点灯。
NEXT_PUBLIC_ENABLE_HANDLES=
# メーター緊急停止 kill-switch (サーバ専用)。'1' で relay 成功時の出来高記録を停止 (relay 自体は無影響)。
# 空/未設定 = メーター有効。a1 フラグが OFF でも記録だけは貯める設計 (点灯前から課金根拠を蓄積)。
BILLING_METER_DISABLED=

# ==========================================================================
# OpenPay Pro (月額固定 ¥500=500 JPYC の前払いサブスク・ゲート対象 = CSV ダウンロードのみ)
# 店主が 500 JPYC を FEE_RECEIVER へ送金 → txHash を /api/pro/subscribe に自己申告 → on-chain 検証 →
# 30日 Pro 付与。前払い式 = 未収リスクゼロ・督促不要。閲覧/決済受取/QR/レジ/チップは無料のまま。
# per-tx の recover 手数料 / a1 利用料とは別系統で両立する。設計: plans/pro-plan.md
# ==========================================================================
# Pro の有効化フラグ (client 露出)。'1'/'true' で ProPaywall 表示 + /api/pro/* 起動。
# **既定 OFF** = /api/pro/* は 404・CSV は無料のまま挙動完全不変。
# 本番点灯 = 本フラグ '1' + ALPHA_ENTITLEMENT_BYPASS=0 + NEXT_PUBLIC_FEE_RECEIVER_ADDRESS 設定済
# (未設定だと 500 JPYC が 0x...dEaD に焼ける)。
NEXT_PUBLIC_ENABLE_PRO=

# ==========================================================================
# CSV 24時間パス (都度 100 JPYC・ゲート対象 = 会計CSVダウンロードのみ)
# 店主が 100 JPYC を FEE_RECEIVER へ送金 → txHash を /api/csv-pass/subscribe に自己申告 →
# on-chain 検証 → 支払い tx の block timestamp + 24時間 を決定論的に付与。前払い式 = 未収リスクゼロ。
# 履歴の閲覧/決済受取/QR/レジ/チップは無料のまま。CSV ゲートは Pro (月額) から都度パスへ置換し、
# Pro は温存 (将来の継続価値の傘へ)。Pro ⊃ CSV: 有効な pro:exp はパス無しでも CSV を解放。
# 設計: plans/csv-pass.md
# ==========================================================================
# CSV パスの有効化フラグ (client 露出)。'1'/'true' で CsvPassPaywall 表示 + /api/csv-pass/* 起動。
# **既定 OFF** = /api/csv-pass/* は 404・CSV は無料のまま挙動完全不変。
# 本番点灯 = 本フラグ '1' + ALPHA_ENTITLEMENT_BYPASS=0 + NEXT_PUBLIC_FEE_RECEIVER_ADDRESS 設定済
# (未設定だと 100 JPYC が 0x...dEaD に焼ける)。
NEXT_PUBLIC_ENABLE_CSV_PASS=

# ==========================================================================
# モバイルオーダー (事前決済 + 店頭/券売機 + Nostr通知 + QR照合) の有効化フラグ (client 露出)。
# **既定 OFF** = 注文ページ/設定UI/ダッシュボードは非表示・挙動完全不変。
# 点灯は開示更新 (店頭1%/モバイル3%) + 弁護士/FSA 確認後 (計画: plans/mobile-order-nostr.md)。
NEXT_PUBLIC_ENABLE_MOBILE_ORDER=

# JPYC Shops API + 店舗検索掲載 opt-in checkbox (client 露出)。**既定 OFF** = checkbox / API とも無効。
# API は facilitator + order relay + server-only ENABLE_AGENT_ORDER との AND (どれか OFF で 404)。
NEXT_PUBLIC_ENABLE_SHOPS_API=

# ==========================================================================
# モバイル注文の「受注リレー」(client 露出)。**既定 OFF** = MobileOrderView は
# webhook を付けず・受注タブ非表示・/api/order/* は 404 → 本番完全 inert。
# 点灯時: 顧客の決済成功 → /api/order/notify が txHash を on-chain 検証 → 店主の
# KV 受注リスト (TTL 72h・資金不触=ノンカストディ不変・PII 非保存) → 店主が SIWE で
# 受注画面に表示。決済コア/手数料(0%)/USDC は無改変 (計画: plans/swift-puzzling-sky.md)。
NEXT_PUBLIC_ENABLE_ORDER_RELAY=

# ==========================================================================
# 注文メモ (アレルギー・要望、client 露出)。**既定 OFF**。ON のとき注文ページで任意入力を受け、
# 同一タブの sessionStorage 経由で受注 notify のみに渡す (URL/履歴には保存しない)。
# NEXT_PUBLIC_ENABLE_ORDER_RELAY と AND でゲートされ、relay OFF 時は常に inert。
NEXT_PUBLIC_ENABLE_ORDER_MEMO=

# ==========================================================================
# 店内のスタッフ呼び出し (client 露出)。**既定 OFF**。決済済み注文の控え + 受注リスト照合を必須にし、
# 1注文5回・店舗10回/5分・同テーブル30秒 cooldown を単一 Lua で原子適用。店側は受注画面内の
# poll/chime のみ (Web Push には載せない)。NEXT_PUBLIC_ENABLE_ORDER_RELAY と AND でゲート。
# 本番点灯時は IP limiter の補助防御を有効にするため IP_HASH_SECRET も設定する。
NEXT_PUBLIC_ENABLE_ORDER_CALL=

# ==========================================================================
# モバイル注文システム利用料 (店頭1% / 事前3%) の有効化フラグ (client 露出)。**既定 OFF** =
# モバイル注文は手数料ゼロ・客への表示は原価のみ・relay は従来 recoverFee → 本番完全 inert。
# gas-recovery 料金 (RECOVER_FEE_BPS・7月から1%) とは別物で、モバイル注文という付加価値システムの
# 利用料を経路非依存 (relay/standard 両方) で頂く。点灯は開示更新 (lib/legal.ts に施行日+条項) と
# 同一リリース + ユーザ最終承認後。/pay QR・/tip・通常 checkout リンクは対象外 (この flag に無関係)。
NEXT_PUBLIC_ENABLE_MOBILE_ORDER_FEE=

# ==========================================================================
# レジ (店頭POS・RegisterMode→/checkout) の OpenPay利用料を経路非依存化するフラグ (client 露出)。
# **既定 OFF** = レジの通常決済(standard)は従来どおり無料 → 本番完全 inert。ON のとき レジ経由の
# JPYC standard 決済にも既存 recover の OpenPay利用料 (RECOVER_FEE_BPS・7月から1%・フロア無し) を
# 店舗負担で課金 (relay 経路は既存 recover が徴収済で不変)。USDC 無料据置・決済QR(/pay)・チップ・
# 手動 checkout リンクは対象外。点灯は 7月 (RECOVER_FEE_BPS=100) + 開示更新と同一リリース。
NEXT_PUBLIC_ENABLE_REGISTER_FEE=

# ==========================================================================
# 店舗のライブ運用状態 (売り切れ / 受付一時停止) の有効化フラグ (client 露出)。
# **既定 OFF** = /api/shop/live は 404・店主のライブ操作パネル非表示・公開ページは live 状態を
# 読まず従来どおり (= 本番完全 inert)。ON のとき @handle 公開店舗で店主が商品ごとの売り切れ /
# 受付一時停止をトグルでき、顧客の公開ページがサーバ読取して反映する (advisory)。静的 storefront
# とは別の KV レコード (shop:live:<handle>) で高頻度トグルに対応。要 KV +
# NEXT_PUBLIC_ENABLE_HANDLES + NEXT_PUBLIC_ENABLE_MOBILE_ORDER。計画: plans/restaurant-pos-roadmap.md。
NEXT_PUBLIC_ENABLE_SHOP_LIVE=

# ==========================================================================
# メニューオプション (サイズ/トッピング) の有効化フラグ (client 露出)。
# **既定 OFF で完全 inert** = オプション編集 UI 非表示・顧客/レジは options を読まず従来の
# 数量ステッパ直追加・既存メニュー(options 無)は不変。ON のとき商品に OptionGroup[]
# (single=サイズ / multi=トッピング・非負 priceDelta) を定義でき、選択で cart line の実効単価=
# base+Σdelta + 表示名サフィックス化する (URL/order スキーマは無改変=lib/menuOptions の非対称設計)。
# 計画: plans/restaurant-pos-roadmap.md Phase 2。
NEXT_PUBLIC_ENABLE_MENU_OPTIONS=

# ==========================================================================
# 受注フルフィルメント (厨房モニター + ホール配膳・商品別ステータス) の有効化フラグ (client 露出)。
# **既定 OFF で完全 inert** = /orders/kitchen・/orders/hall は 404・受注フィードの商品別操作 UI 非表示・
# 既存の受注パネル (対応済みトグル) は不変。ON のとき店主が受取ウォレットでサインインし、厨房 (商品別
# 「調理済み」) / ホール (調理済=青・商品別「配膳済み」) の 2 画面で受注を進捗管理。状態更新は op 化 +
# kvEval 原子更新で多端末の同時トグルを安全化。要 NEXT_PUBLIC_ENABLE_ORDER_RELAY。
# 計画: plans/restaurant-pos-roadmap.md Phase 3。
NEXT_PUBLIC_ENABLE_ORDER_FULFILLMENT=

# ==========================================================================
# モバイル注文の時間系 (ラストオーダー自動停止 / 最短受け渡し / 時間指定事前注文) の有効化フラグ
# (client 露出)。**既定 OFF で完全 inert** = builder の lastOrder/minLeadMinutes 入力 非表示・公開
# ページはラストオーダー停止/最短受取/スロット選択を出さず従来どおり・受注に pickupAt が付かない。
# ON のとき店舗は「ラストオーダー HH:mm」(超過で受付停止=Phase1 停止経路を再利用) と「最短受け渡し
# 分数」を設定でき、preorder では顧客が受取スロット (15分刻み) を選んで pickupAt を注文へ付与、厨房/
# ホールが受取予定時刻を表示する。タイムゾーンは Asia/Tokyo 固定 (lib/shopTime)。
# 計画: plans/restaurant-pos-roadmap.md Phase 4。
NEXT_PUBLIC_ENABLE_PREORDER_TIME=

# ==========================================================================
# 受注閲覧トークン (店員端末を資金鍵なしで厨房/ホールに繋ぐ) の有効化フラグ (client 露出)。
# **既定 OFF で完全 inert** = /api/order/token は 404・オーナーUIの発行パネル非表示・feed は
# x-order-token を無視 (SIWE 専用)。ON のとき受取ウォレットのオーナーが「受注閲覧トークン」を発行し、
# 店員端末は /orders/{kitchen,hall}?t=<token> を開くだけ (ウォレット不要) で受注の閲覧+進捗操作が可能。
# トークンは閲覧/操作のみ=送金・受取先変更は不可 (資金鍵を持たない) → 店員の売上スキミングを構造的に防ぐ。
# 再発行で旧トークン即失効。要 KV + NEXT_PUBLIC_ENABLE_ORDER_RELAY。計画: plans/restaurant-pos-roadmap.md Phase 5。
NEXT_PUBLIC_ENABLE_ORDER_TOKEN=

# ==========================================================================
# 顧客向け「お渡し準備完了」通知 (モバイル注文・受取来店パターン) の有効化フラグ (client 露出)。
# **既定 OFF で完全 inert** = /order/status・/api/order/status は 404・CheckoutForm は status トークンを
# 生成せず webhook payload/完了画面リンクとも不変・ホールの「準備完了」ボタン非表示・feed は markReady op
# を拒否。ON のとき ①ホールが「お渡し準備完了(通知)」を押すと受注に ready/readyAt が立ち ②顧客は決済
# 完了画面のリンクから /order/status?t=<token> を開いて待つと、準備完了で「お渡しする準備ができました」+
# チャイムが出る。通知到達はページを開いている間のみ (Web Push は使わない・画面を開いたまま待つ前提=
# Screen Wake Lock で緩和)。要 KV + NEXT_PUBLIC_ENABLE_ORDER_RELAY (+ホール操作は ENABLE_ORDER_FULFILLMENT)。
# 計画: plans/order-pickup-notify.md。
NEXT_PUBLIC_ENABLE_ORDER_PICKUP=

# ==========================================================================
# Web Push 着金通知 (Phase 2a: SW + 購読 API + KV schema)
# **既定 OFF で完全 inert** = Service Worker 登録 UI は出さず、/api/push/* は 404。
# 鍵生成: npx web-push generate-vapid-keys
# PUSH_VAPID_PRIVATE_KEY / PUSH_VAPID_SUBJECT は server-only。NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY
# はブラウザの PushManager.subscribe(applicationServerKey) に渡す公開鍵。
# 購読は KV の push:subs:{wallet} に 90日 TTL / wallet あたり最大 5 台で保存する。
# ==========================================================================
NEXT_PUBLIC_ENABLE_PUSH_NOTIFY=
NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:ops@example.com

# ==========================================================================
# オフライン受け取り QR (Phase 4: SW fetch 拡張 + 前回 QR の圏外提示)
# **既定 OFF で完全 inert** = Service Worker は fetch を一切 intercept せず (enable マーカー
# 不在=素通し)・OfflineLastQr 非描画・offline.html 不使用。ON のとき /create 訪問で '/sw.js'
# を登録し (push と同一 script)、SW が narrow なパターン (同一オリジン GET /_next/static/* と
# /create への full navigation のみ) を cache-first / network-first で応答する。API/POST/
# クロスオリジン・/pay・/scan・/checkout 等の決済経路には一切介入しない。
# 計画: plans/a2hs-retention-roadmap.md Phase 4。
# ==========================================================================
NEXT_PUBLIC_ENABLE_OFFLINE_QR=

# ==========================================================================
# x402 protocol: AI agent / API per-request 課金
# (Open Checkout for AI Agents)
# /api/paid/* を withX402Payment で wrap し、未払いリクエストには HTTP 402 +
# x402 payment requirements を返す。client (AI agent) は USDC を sign して
# X-PAYMENT header 付きで再リクエストする。
# 詳細: README の §「Open Checkout for AI Agents」
# ==========================================================================
# facilitator。⚠️ x402.org は Base **mainnet を settle できない** (2026-07-28 実測:
# /supported は base-sepolia のみ)。本番 (X402_NETWORK=base) は payai を使用
# (鍵不要・8453 exact 対応・不正署名の拒否を実測確認)。pay.openfacilitator.io は
# /verify が署名も宛先も検証しないため使用禁止。production では https:// 必須。
X402_FACILITATOR_URL=https://x402.org/facilitator
# 本番: X402_FACILITATOR_URL=https://facilitator.payai.network
#
# vanilla USDC gate の facilitator 切替 (任意)。'cdp' で Coinbase CDP facilitator
# (api.cdp.coinbase.com) を使う — CDP が settle した discoverable エンドポイントは
# x402 Bazaar → agentic.market に自動掲載される。未設定なら上の URL のまま挙動不変。
# 'cdp' には下の CDP_API_KEY_ID / CDP_API_KEY_SECRET が必須 (欠けると起動時 throw)。
X402_VANILLA_FACILITATOR=
# CDP API キー (portal.cdp.coinbase.com で作成・Secret API Key)。server-only。
# Ed25519 (base64 64byte・現行既定) と ECDSA PEM/PKCS8 の両形式に対応。
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# base / base-sepolia (USDC、testnet 既定) | polygon / polygon-amoy (JPYC)
X402_NETWORK=base-sepolia
# 支払い受取アドレス。mainnet (network=base) では起動 guard で必須、testnet
# は未設定でも burn address fallback で動作 (本番運用前に必ず設定)。
X402_PAY_TO_ADDRESS=
# 既定 asset (省略時は network 既定を使用: Base→native USDC / Polygon→JPYC v3)。
# bridged USDC.e は非対応、必ず native USDC を指定すること。
X402_ASSET=
# 既定 price (route 側で override 可能)。
#   Base / Base Sepolia: USD 表記 ("$0.001" 等)、x402-next が USDC atomic (6
#     decimals) に自動変換
#   Polygon / Polygon Amoy: JPYC 単位の human decimal ("1" = 1 JPYC = 1 JPY)、
#     parseUnits(value, 18) で atomic に変換。"$" prefix は strip して扱う
X402_PRICE=$0.001
# 開発時 payment 検証 bypass (true で paid route を素通し)。
# NODE_ENV=production と同時設定で起動失敗 (本番で課金 bypass は禁止)。
X402_TEST_MODE=false

# Buyer SDK / MCP が売り手申告の authorization 有効期間へ設ける上限 (秒)。
# 既定 600、設定可能範囲 1〜1200。超過申告は clamp せず署名前に拒否する。
MAX_TIMEOUT_SECONDS=600

# ===== Managed JPYC x402 Facilitator + Discovery (我々が運営する facilitator) =====
# 上の X402_* (X402_NETWORK 等) は「売り手として外部 facilitator を使う」設定。
# 以下は「我々自身が facilitator を運営し /supported /verify /settle を出し、
# settlement の 1% を非カストディに徴収する」設定 (plans/x402-jpyc-facilitator.md)。
#
# 有効化フラグ (client 露出)。**既定 OFF で完全 inert** = /api/facilitator/* と
# /api/discovery は 404・/discovery と登録 UI は非表示。点灯は testnet(Amoy) E2E +
# 開示更新と同一リリース。'1' / 'true' で ON。
NEXT_PUBLIC_ENABLE_X402_FACILITATOR=
# Creator Store の出品管理 / @handle 商品節 UI。client 表示専用・既定 OFF。
# server API は下の server-only flag も別途必要。
NEXT_PUBLIC_ENABLE_CREATOR_STORE=
# Creator Store の出品 API / money-path / status / reconciler。server-only・既定 OFF。
ENABLE_CREATOR_STORE=
# Japan Web3 Directory API + OpenAPI。既定 OFF。paid API は facilitator flag との AND。
NEXT_PUBLIC_ENABLE_WEB3_DIRECTORY=
# x402 手数料率 (basis points・server-only)。既定 100 (=1%)。fat-finger 上限 1000 (=10%)。
# facilitator は flag でゲートされるため点灯時は意図どおり 1% を既定にする。
X402_FEE_BPS=100
# x402 手数料の下限 (human JPYC 整数・server-only)。既定 1 (= 1 JPYC・ユーザ確定)。
# 手数料 = max(この floor, price × bps/10000)・買い手上乗せ・seller は表示額を受領。
# 0/不正は既定 1 へ倒す (forwarder の feeValue==0 ZeroValue revert を構造的に防ぐ)。
# ⚠️ x402 はマイクロペイメント主用途のため、¥100 未満の決済では floor が額面 1% を超える
# (例: ¥10→¥1=10%)。真のマイクロ決済を成立させる場合は go-live 前にこの値を下げる。
X402_FEE_FLOOR_JPYC=1
# 受領証明 (receipt) 署名鍵 (server-only・0x 秘密鍵・relayer とは分離する)。settle 成功時に
# OpenPayX402Receipt を EIP-712 署名し、/api/facilitator/verify-receipt でオフライン検証可能にする。
# 未設定なら receipt は発行されない (settle 自体は成立する)。Vercel では Sensitive フラグ必須。
# 流用しない (relayer 鍵を receipt に使うと hot key の用途が広がるため別鍵にする)。
X402_RECEIPT_SIGNING_KEY=
# Vercel Cron /api/cron/reverify の Bearer 認証 secret (server-only)。未設定なら route は常に 401。
# `openssl rand -base64 32` 等で生成し、Vercel では Sensitive として保存する。
CRON_SECRET=
# 再検証の確定違反・一時障害・hidden/復帰を通知する Slack/Discord 互換 webhook (任意)。
# POST body は {text,content}。通知失敗は検証 state 更新へ波及しない。
ALERT_WEBHOOK_URL=
# 受取は既存の forwarder + FEE_RECEIVER を再利用する (別途設定不要):
#   - NEXT_PUBLIC_JPYC_FORWARDER_AMOY / _POLYGON (settle の分割先・上の relay 設定と共有)
#   - NEXT_PUBLIC_FEE_RECEIVER_ADDRESS (手数料 1% の受領先・会社ウォレット)
#   - RELAYER_PRIVATE_KEY (settle を broadcast する relayer・ガスのみ負担)

# ===== エージェント注文 (agent-order) =====
# Claude Desktop / Claude Code の openpay-x402-mcp から @handle 店舗のモバイルオーダーを x402 で
# 支払い、既存の受注リレー (/api/order/notify) へ届ける /api/agent-order/{menu,pay} の有効化フラグ。
# **server-only** (NEXT_PUBLIC を付けない = client bundle に出さない・API route のみが参照)。
# **既定 OFF で完全 inert** = /api/agent-order/* は 404。上の NEXT_PUBLIC_ENABLE_X402_FACILITATOR +
# NEXT_PUBLIC_ENABLE_ORDER_RELAY と AND でゲートするため、どれか一つでも OFF なら全 route 404。
# 支払いは既存 x402 レール (forwarder-split・買い手上乗せ 1%)・受注登録は既存リレーを再利用 (新レール無し)。
# 点灯は自店舗 testnet/mainnet 実注文 E2E 後。計画: plans/agent-order-x402.md。'1' / 'true' で ON。
ENABLE_AGENT_ORDER=

# ===== dual-rail 出品 (AI ストア出品の USDC/Base 面) =====
# 出品者の API を CDP Bazaar にも載せるための verify/settle 中継
# /api/x402/relay/{requirements,verify,settle} の有効化フラグ。
# **server-only** (NEXT_PUBLIC を付けない = client bundle に出さない・API route のみが参照)。
# **既定 OFF で完全 inert** = /api/x402/relay/* は 404。NEXT_PUBLIC_ENABLE_X402_FACILITATOR
# (レジストリの親 flag) と AND でゲート。動作には X402_VANILLA_FACILITATOR=cdp (CDP 鍵) が必要
# (無ければ 503 = 掲載されない中継を黙って提供しない)。掲載メタはレジストリ登録値のみから注入
# (catalog poisoning 防止)。資金は購入者 → 出品者 payTo 直接・OpenPay の USDC 側手数料なし。
# 計画: plans/dual-rail-listing.md。'1' / 'true' で ON。
ENABLE_X402_DUAL_RAIL=

# 上記 dual-rail の **UI 面**: 出品フォームの「USDC (Base) でも販売」opt-in の表示フラグ。
# server の ENABLE_X402_DUAL_RAIL (リレー本体) と対で点灯は両方同時 (UI だけ先に出すと
# 「登録したのにリレー 404」の期待違いを作る)。既定 OFF = フォームは従来どおり JPYC のみ。
NEXT_PUBLIC_ENABLE_X402_DUAL_RAIL=

# ===== Cross-chain USDC Receive (Circle Gateway 経由) =====
# phase 1 experimental demo route の mount 制御。default false (= route 404)。
# operator が "1" / "true" で opt-in すると /[locale]/experimental/cross-chain-demo
# が利用可能になる (HashPort 実機検証 + testnet 1 周動作確認用)。
# 本線 PaymentForm 統合は phase 2 (本 flag は phase 2 完了後に退役)。
NEXT_PUBLIC_EXPERIMENTAL_CROSS_CHAIN_ENABLED=false
# Incident kill switch: "true" / "1" で CrossChainHint が non-mount → 全 buyer
# に対し cross-chain UI を disable。Circle attestation API 障害 / Sentry で
# cross-chain.execute.failed 急増時の対応用。
#
# ⚠ Next.js 仕様: NEXT_PUBLIC_* は build 時に client bundle へ inline される
# ため、Vercel env を flip しても auto rebuild (~2-5 min) が必要 (instant では
# ない)。**真の "instant disable" は Vercel Dashboard の "Instant Rollback"**
# (前 deployment へ 1-click promote、rebuild 不要) を first option として使う。
# 本 env は「cross-chain 機能だけ targeted に disable したいが他は保持したい」
# 用途 (~2-5 min lag 許容)。
# default 空 = enabled (= phase 2 通常運用)。
NEXT_PUBLIC_CROSS_CHAIN_DISABLED=
# CCTP burn の中断再開で「未 broadcast と結論できた」状態 (burn-intent marker 以降に
# nonce が動かず・mempool 空・DepositForBurn log 無し・十分な時間経過) からの **自動**
# 再 burn を許可する。既定 OFF = 同じ状況を manual に落とし、買い手が Explorer で自分の
# USDC が減っていないことを確認して二段確認した場合のみ再送金する (Phase 1)。
# marker 書込 (fail-closed)・revert 検出・log 走査・adopt は本 flag と無関係に常時 ON。
# 点灯は本番の manual 到達率 (Sentry: cross-chain.burn.unresolved) を観測してから。
NEXT_PUBLIC_CROSS_CHAIN_BURN_AUTORESUME=
# Circle attestation API host 上書き (空なら NETWORK_ENV に応じて
# https://gateway-api.circle.com / https://gateway-api-testnet.circle.com を
# 自動選択)。Circle host 障害時に operator が緊急で切替えるための knob。
NEXT_PUBLIC_CIRCLE_GATEWAY_API_URL=
# CCTP V2 iris attestation API host 上書き (空なら NETWORK_ENV で
# https://iris-api.circle.com / https://iris-api-sandbox.circle.com 自動選択)。
NEXT_PUBLIC_CIRCLE_IRIS_API_URL=
# Gateway BurnIntent maxFee 上限の bps (整数 1-10000)。空 = 既定 10 bps (= 0.1%)。
# Circle 公開 fee は 0.5 bps なので 10 bps は 20x の safety margin。
# Circle 仕様変更時に再 deploy なしで上書きするための knob。
NEXT_PUBLIC_CROSS_CHAIN_MAX_FEE_BPS=
# Gateway BurnIntent maxBlockHeight の全 chain 共通 override (緊急 hot-fix 用)。
# 空 = 既定の chain 別 table (Polygon/Base/OP = 600 / Arbitrum = 5000) を使う。
# chain-aware default で問題が出た時のみ override する。
NEXT_PUBLIC_CROSS_CHAIN_BLOCK_OFFSET_DEFAULT=

# ==========================================================================
# ガスレス / スマートアカウント 機能フラグ (いずれも client 露出・既定 OFF)
# ==========================================================================
# Circle Paymaster (USDC ガスレス・EIP-2612 permit で顧客が USDC で gas を払う・当社徴収0)。
# '1'/'true' で有効。OFF の間は従来の Pimlico ERC20 paymaster 経路。対応は Base/Arbitrum/Optimism
# (lib/circlePaymaster の allowlist・surcharge は chain 別 hard-code)。
NEXT_PUBLIC_ENABLE_CIRCLE_PAYMASTER=
# Alchemy Modular Account v2 (MAv2) 経路。'1'/'true' で有効。OFF の間は pimlico-simple-7702。
# Pimlico bundler が MAv2 sender を accept するまで待機中 (既定 OFF)。
NEXT_PUBLIC_ENABLE_MAV2=
# MetaMask Smart Account (Stateless 7702)。'1'/'true' で有効。viem 2.50 ↔ delegation-toolkit の
# 署名非互換で現状無効化し standard mode に倒している (再有効化前に実機再検証必須・既定 OFF)。
NEXT_PUBLIC_ENABLE_METAMASK_SMART_ACCOUNT=

# ==========================================================================
# JPYC ガスレス決済 (EIP-3009 relay)
# 顧客が transferWithAuthorization に EIP-712 署名 → relayer が代理 submit + ガス負担。
# 委任不要で任意の injected wallet が対象。対応: Polygon (137) / Amoy (80002)。
# ==========================================================================
# client 機能フラグ。'1' or 'true' で JPYC ガスレスを EIP-3009 relay に倒す (既定 OFF)。
# OFF の間は従来の Pimlico 7702 経路。
NEXT_PUBLIC_ENABLE_JPYC_EIP3009=
# JPYC gasless relay の成功チップに非公開メッセージを添える機能。**既定 OFF で完全 inert**。
# ON のときだけ送信欄と SIWE inbox/API を有効化する。メッセージは受取ウォレット本人だけが閲覧でき、
# KV に最大 200 件・最長 180 日保存され、受取画面からすべて削除できる。
NEXT_PUBLIC_ENABLE_TIP_MESSAGE=
# JPYC を Avalanche (本番) / Avalanche Fuji (testnet) でも提供するフラグ。**既定 OFF**。OFF の間は
# JPYC_CHAINS=['polygon','kaia'] のままで挙動完全不変。'1'/'true' で ON にすると NETWORK_ENV=testnet
# では Fuji、mainnet では Avalanche が JPYC チェーンに加わる。⚠️ Avalanche は recover-required:
# forwarder (下記 NEXT_PUBLIC_JPYC_FORWARDER_AVALANCHE/_FUJI) 未設定なら gasless 非提供=通常送金へ倒す
# (free モードで OpenPay relayer が AVAX を持ち出す赤字を防ぐ)。testnet 確認手順:
# NEXT_PUBLIC_ENABLE_JPYC_AVALANCHE=1 + NEXT_PUBLIC_NETWORK_ENV=testnet + Fuji forwarder + relayer に Fuji AVAX。
NEXT_PUBLIC_ENABLE_JPYC_AVALANCHE=
# JPYC を Ethereum L1 (mainnet) でも受取可能にするフラグ。**既定 OFF**。'1'/'true' + NETWORK_ENV=mainnet
# で JPYC_CHAINS に 'ethereum' が加わる (JPYC は L1 mainnet のみ・Sepolia 未 deploy なので testnet では無効)。
# ⚠️ Ethereum は **standard モード固定**: L1 ガスは高変動で gasless recover が不経済なため forwarder を
# 設けない設計 (paymasterMode='unavailable' → 顧客が ETH ガスを負担・OpenPay relayer/forwarder 不使用)。
# 直接 relay POST は server が 503 relay_not_configured で拒否する (free relay 持ち出しの構造的防止)。
NEXT_PUBLIC_ENABLE_JPYC_ETHEREUM=
# 【開発専用】接続後 UI のスクショ/E2E 用 mock ウォレットを connector 一覧に出す。'1' で ON。
# NODE_ENV=production では env に関わらず無効 (本番バンドルから dead code として除去される)。
# アドレスは hardhat/anvil 既知テストアカウント #0 (秘密鍵公知)。本番/Vercel には設定しない。
NEXT_PUBLIC_ENABLE_MOCK_WALLET=
# 【開発専用】/store 一覧を UI 磨きスクショ用フィクスチャ商品で描画する。'1' で ON。
# VERCEL 環境変数が立つ環境では env に関わらず無効 (偽商品が本番一覧に出る波及を構造的に断つ)。
STORE_DEV_FIXTURES=
# 送信 provider は起動時に確定する (within-request の failover はしない):
#   RELAYER_PRIVATE_KEY あり → self-host (運営 EOA が直接 submit・POL 負担。既定・推奨)
#   なければ GELATO_SPONSOR_API_KEY あり → Gelato sponsoredCall (deploy 単位の rollback 用)
#   どちらも無し → relay 無効 (client は 7702/standard へ fallback)
#
# self-host relayer の秘密鍵 (サーバ専用・NEXT_PUBLIC は付けない!)。
# `node scripts/relayer-wallet.mjs` で使い捨て EOA を生成し、その address に POL を入金する
# (Amoy は faucet 無料 / 本番 Polygon は $1-2 相当)。鍵が持つのは POL のみで顧客資金は扱えない。
RELAYER_PRIVATE_KEY=
# Gelato fallback 用 sponsor API key (任意。self-host を使うなら不要)。
GELATO_SPONSOR_API_KEY=
# Gelato REST base URL 上書き (任意・既定 https://api.gelato.digital)。
GELATO_RELAY_BASE_URL=
# relay 1 件あたりの上限 (human JPYC・濫用ガード + 立替を少額化)。空 = アルファ既定 5 万 JPYC。
# provider 非依存 (self-host/Gelato 共通)。旧名 GELATO_RELAY_MAX_JPYC も後方互換で読む。
RELAY_MAX_JPYC=
# 旧名 (後方互換のみ・新規設定は上の RELAY_MAX_JPYC を使う)。
# GELATO_RELAY_MAX_JPYC=

# --- Phase B hardening (mainnet 前提・self-host のみ有効) ---
# 注: mainnet (Polygon 137) を self-host で relay するには KV (KV_REST_API_URL/TOKEN) 必須。
# 未設定だと idempotency が fail-open になり二重 submit リスク → mainnet は 503 kv_required で拒否。
# B4 circuit breaker: chain 日次の relay 件数上限 (Sybil による POL 枯渇 griefing を止める)。
# 空/不正/巨大値 = 既定 500。非負の有限 safe integer のみ有効。KV (Upstash) 設定時のみ機能・
# fail-open (KV 障害は通す)。UTC 日付でカウント。
RELAY_DAILY_TX_CAP=
# forwarder の回収額が chain 別ガスフロア未満になる settle 専用の別枠 (UTC 日次・chain 単位)。
# 共有 RELAY_DAILY_TX_CAP より先に評価し、低回収 settle が通常の gasless 枠を枯らすのを防ぐ。
# 空/不正/巨大値 = 実効共有枠の 20% (整数切捨て、共有枠 500 なら 100)。共有枠が正なら明示値も
# 共有枠未満へ clamp (共有枠 1 なら 0)。0 にすると sub-floor settle を停止。
RELAY_SUBFLOOR_DAILY_TX_CAP=
# 同じ署名済み払い元が上の専用枠を単独で枯らさないための UTC 日次上限 (chain + payer 単位)。
# 空/不正/巨大値 = 実効専用枠の 20% (整数切捨て、専用枠 100 なら 20)。専用枠 > 1 なら明示値も
# 専用枠未満へ clamp。専用枠 1 なら最大 1、専用枠 0 なら 0。Sybil は上の chain 単位枠で止める。
RELAY_SUBFLOOR_PAYER_DAILY_TX_CAP=
# B5 赤字防止: 1 tx の native (POL) gas コスト上限 (wei)。gas見積×gasPrice がこれを超える高騰時は
# relay せず standard モードへ倒す。空/0 = 無効 (testnet 既定)。mainnet は回収 fee 相当額に設定。
# 例: 0.01 POL = 10000000000000000 (回収 fee 2 JPYC が賄える範囲で worst-case を弾く値にする)。
RELAY_MAX_GAS_COST_WEI=
# per-chain の native gas 上限 (wei)。設定した chain のみ上のグローバル値より優先。⚠️ native の価値が
# 桁違い (AVAX ~$15-40 vs POL/KAIA ~$0.1-0.5) のため、Avalanche mainnet はグローバル値 (POL/KAIA 用) では
# 緩すぎる。Avalanche を本番点灯する前に AVAX 用の上限を必ず設定すること (例: 0.05 AVAX =
# 50000000000000000)。Fuji は testnet (MAINNET_CHAINS 外) なので未設定=無制限で可。
RELAY_MAX_GAS_COST_WEI_AVALANCHE=
RELAY_MAX_GAS_COST_WEI_FUJI=
# relayer の native 残高がこれ未満になったら submit 前に Sentry 警告 (枯渇 relayer_unfunded の手前で
# operator が補充できるように)。wei。空 = 既定 0.1 native (1e17 = 100000000000000000)。0 で無効。
RELAY_LOW_BALANCE_ALERT_WEI=
# B1 Layer B: ガスレス relayer の事前 (preflight) 健全性プローブ (/api/relay/jpyc/health) で
# degraded:low_balance と判定する native 残高フロア (wei)。空 = chain 既定 (Polygon/Kaia=5 native
# =5e18、testnet 等それ以外=0.01 native=1e16・scripts/check-pimlico-balance.mjs の保守値に準拠)。
# advisory のみ (決済の実行経路には影響しない・degraded なら署名前に「通常決済へ切替」を案内するだけ)。
RELAY_HEALTH_MIN_BALANCE_WEI=

# --- recover モード (per-tx で gas 相当額を JPYC 回収・forwarder 経由) ---
# Eip3009Forwarder の deploy 済アドレスを chain 別に設定すると、その chain は recover モードに
# なる (顧客 1 署名で amount→店舗 + gas相当→feeReceiver を分割回収)。未設定なら free モード
# (OpenPay がガス負担・満額着金)。client が nonce-commit を組むため NEXT_PUBLIC (server は値を信用せず強制)。
# 未 deploy の間は空 = free。deploy 手順は contracts/README.md。
# ⚠️ a1「OpenPay 利用料」(NEXT_PUBLIC_ENABLE_USAGE_FEE) とは**排他**。両方有効だと二重課金になり、
#    かつ recover 経路は a1 のメーター/関所を通らない (handleRecover には計上も gate も無い)。a1 を
#    使う chain では forwarder を空にする。← testnet で a1 を試すとき Amoy の forwarder を外すのはこの理由。
NEXT_PUBLIC_JPYC_FORWARDER_POLYGON=
NEXT_PUBLIC_JPYC_FORWARDER_AMOY=
NEXT_PUBLIC_JPYC_FORWARDER_KAIA=
NEXT_PUBLIC_JPYC_FORWARDER_KAIROS=
NEXT_PUBLIC_JPYC_FORWARDER_AVALANCHE=
NEXT_PUBLIC_JPYC_FORWARDER_FUJI=
# 顧客から JPYC で回収する gas 相当額 (回収フロア・human JPYC)。空 = 既定 2 JPYC。
# Polygon の sub-cent gas を十分賄う固定額。recover の徴収額の **下限** として効く
# (= max(このフロア, billAmount × RECOVER_FEE_BPS/10000))。NEXT_PUBLIC で client/server 共有 (nonce 一致)。
# これは **全 chain 共通のグローバル既定**。chain ごとに native gas の価値が桁違い (POL/KAIA 安い vs
# AVAX 高い) のため、下の per-chain 上書きで chain 別フロアを設定できる (Avalanche のチップ黒字化等)。
NEXT_PUBLIC_RELAY_GAS_FEE_JPYC=
# per-chain フロア上書き (human JPYC)。設定した chain のみ上のグローバル値より優先。空 = グローバル値
# (→ 2) にフォールバック。解決順: per-chain → グローバル → 2。各段で 0/不正は採用せず次段へ
# (ZeroValue revert 回避)。⚠️ floor を 2 以外にする chain は lib/legal.ts の開示 (約 2 JPYC) と
# 法務本文の改定が必要 (feeDisclosureDivergence が乖離を warn する)。Avalanche を relay 点灯する際は
# 実測 AVAX gas の 2〜3× バッファで設定すること。
NEXT_PUBLIC_RELAY_GAS_FEE_JPYC_POLYGON=
NEXT_PUBLIC_RELAY_GAS_FEE_JPYC_KAIA=
NEXT_PUBLIC_RELAY_GAS_FEE_JPYC_AVALANCHE=
NEXT_PUBLIC_RELAY_GAS_FEE_JPYC_AMOY=
NEXT_PUBLIC_RELAY_GAS_FEE_JPYC_KAIROS=
NEXT_PUBLIC_RELAY_GAS_FEE_JPYC_FUJI=
# recover per-tx サービス手数料率 (basis points)。空/0 = ガス回収のみ (既定・inert = 現行の固定 2 JPYC
# 挙動と完全一致)。100 = 1% (recover は max(2 JPYC フロア, billAmount × 1%) を徴収)。上限 1000 (=10%) で
# clamp (fat-finger 防止)。フロアは上の NEXT_PUBLIC_RELAY_GAS_FEE_JPYC。手数料の負担者 (顧客上乗せ /
# 店舗吸収) は決済 form の gasMode トグルが決める。NEXT_PUBLIC で client/server 共有 (nonce 一致)。
NEXT_PUBLIC_RECOVER_FEE_BPS=0
# 注: forwarder は constructor で (JPYC, feeReceiver=NEXT_PUBLIC_FEE_RECEIVER_ADDRESS) を渡して
# deploy すること。route の feeReceiver と一致していないと署名検証が通らない。
# 注: recover (forwarder 設定) は self-host (RELAYER_PRIVATE_KEY) 必須。Gelato では recover 不可
# (forwarder 設定 + 非 self-host は誤設定。client の recover payload が 400 になる)。
