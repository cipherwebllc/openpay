# Public production ON vector for F13; no server flags, credentials or real wallets.
# Sources: README live flags + project-memory records of production ON flags (2026-09-24);
# .env.local.example and lib/env.ts / lib/relay/forwarderConfig.ts define the keys.
# Vercel has not been queried; unconfirmed/default-off features stay unset.
NEXT_PUBLIC_ENABLE_JPYC_EIP3009=1
NEXT_PUBLIC_ENABLE_JPYC_AVALANCHE=1
NEXT_PUBLIC_ENABLE_MAV2=1
NEXT_PUBLIC_ENABLE_HANDLES=1
NEXT_PUBLIC_ENABLE_MOBILE_ORDER=1
NEXT_PUBLIC_ENABLE_ORDER_RELAY=1
NEXT_PUBLIC_ENABLE_ORDER_MEMO=1
NEXT_PUBLIC_ENABLE_ORDER_CALL=1
NEXT_PUBLIC_ENABLE_ORDER_FULFILLMENT=1
NEXT_PUBLIC_ENABLE_PREORDER_TIME=1
NEXT_PUBLIC_ENABLE_ORDER_PICKUP=1
NEXT_PUBLIC_ENABLE_PUSH_NOTIFY=1
NEXT_PUBLIC_ENABLE_OFFLINE_QR=1
NEXT_PUBLIC_ENABLE_MOBILE_ORDER_FEE=1
NEXT_PUBLIC_ENABLE_X402_FACILITATOR=1
# NEXT_PUBLIC_ENABLE_REGISTER_FEE stays unset: the register standard-payment fee was abolished on 2026-10-07 and the flag was removed from the code.

# Project-memory production ON flags — NOT yet confirmed against Vercel; the user confirms in the PR.
NEXT_PUBLIC_ENABLE_TIP_MESSAGE=1
NEXT_PUBLIC_ENABLE_USDC_ARC=1
NEXT_PUBLIC_ENABLE_USDC_ARC_TIP=1
NEXT_PUBLIC_ENABLE_USDC_ARC_CROSSCHAIN=1
NEXT_PUBLIC_ENABLE_CREATOR_STORE=1
NEXT_PUBLIC_ENABLE_LICENSE_NFT=1
NEXT_PUBLIC_ENABLE_STORE_DELIVERY_TICKET=1
NEXT_PUBLIC_ENABLE_AGENT_PURCHASES=1
NEXT_PUBLIC_ENABLE_SHOPS_API=1
NEXT_PUBLIC_ENABLE_WEB3_DIRECTORY=1
NEXT_PUBLIC_ENABLE_X402_DUAL_RAIL=1
# "The shop pays the gas" (internal name: store device) — production since 2026-10-08 on Polygon, Kaia and Avalanche.
# Its hand-off API needs server-only IP_HASH_SECRET, which this job never sets: specs pin /api/register/handoff/* with page.route.
NEXT_PUBLIC_ENABLE_STORE_GAS_WALLET=1
# Mainnet-only feature: keep the public flag ON even though testnet leaves it inert.
NEXT_PUBLIC_ENABLE_JPYC_ETHEREUM=1
# "Move sales to another wallet" (/create, Polygon JPYC only) — production since 2026-11-07 (#1044, docs/DEPLOY_CHECKLIST.md §18).
NEXT_PUBLIC_ENABLE_SALES_MOVE=1

# Production ON flags that this vector lacked until 2026-11-11 (10th full review, F-10). Source: the flag names and
# their ON/OFF read from production's public JS (parseBoolFlag keeps each key in the bundle); Vercel is still not queried.
# None needs another public value here: the Circle Paymaster addresses are a hardcoded allowlist (lib/circlePaymaster.ts),
# and the server-only halves (ENABLE_X402_DUAL_RAIL_ARC, KV) stay unset in this job like every other server flag.
# Live shop status on @handle storefronts (sold-out / pause, recommended items, register category filter).
NEXT_PUBLIC_ENABLE_SHOP_LIVE=1
# Menu options (size / topping groups) on mobile-order and register products.
NEXT_PUBLIC_ENABLE_MENU_OPTIONS=1
# Staff link (order view token) for the kitchen / hall / pickup boards.
NEXT_PUBLIC_ENABLE_ORDER_TOKEN=1
# USDC gasless through Circle Paymaster (Base / Arbitrum / Optimism) instead of the Pimlico ERC-20 paymaster.
NEXT_PUBLIC_ENABLE_CIRCLE_PAYMASTER=1
# Arc (Circle Gateway) opt-in inside the AI-store listing form.
NEXT_PUBLIC_ENABLE_X402_DUAL_RAIL_ARC=1
# "Receive Arc proceeds" page (/discovery/arc-payout) and its entry links.
NEXT_PUBLIC_ENABLE_ARC_PAYOUT=1
# NEXT_PUBLIC_ENABLE_USAGE_FEE stays unset: the same read showed it OFF in production.

NEXT_PUBLIC_RECOVER_FEE_BPS=100
NEXT_PUBLIC_RELAY_GAS_FEE_JPYC=2

# Testnet substitutions only. All addresses/keys below are inert CI fixtures;
# page.route supplies API responses and rejects unexpected API/external requests.
NEXT_PUBLIC_NETWORK_ENV=testnet
NEXT_PUBLIC_PIMLICO_API_KEY=dummy_for_build
NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY_ID=sp_dummy
NEXT_PUBLIC_FEE_RECEIVER_ADDRESS=0x000000000000000000000000000000000000dead
NEXT_PUBLIC_JPYC_TESTNET_ADDRESS=0x0000000000000000000000000000000000000abc
NEXT_PUBLIC_JPYC_FORWARDER_AMOY=0x0000000000000000000000000000000000000def
NEXT_PUBLIC_JPYC_FORWARDER_KAIROS=0x0000000000000000000000000000000000000def
NEXT_PUBLIC_JPYC_FORWARDER_FUJI=0x0000000000000000000000000000000000000def
