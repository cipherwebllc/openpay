exports[`CheckoutForm — R14 内訳行 fixture (ja/en) > en > jpyc relay free > closed 1`] = `"<section class="rounded-2xl border border-slate-200 bg-white p-4 text-sm"><p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Items</p><ul class="mt-3 divide-y divide-slate-100"><li class="flex items-baseline justify-between gap-3 py-2"><span class="min-w-0 flex-1 break-words font-medium text-slate-700">チケット</span><span class="shrink-0 font-mono text-xs text-slate-500">×1</span><span class="shrink-0 font-mono text-sm text-slate-800">3000 JPYC</span></li></ul><div class="mt-3 border-t border-slate-200 pt-3"><dl class="space-y-1.5"><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-500">Subtotal</dt><dd class="text-right font-mono text-slate-700">3000 JPYC</dd></div><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-500">Network fee<span class="relative inline-block"><button type="button" aria-label="Show details" aria-expanded="false" class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 bg-white text-[10px] font-bold text-slate-500 hover:border-slate-400 hover:text-slate-700">?</button></span></dt><dd class="text-right font-mono text-slate-700">Free (covered by OpenPay)</dd></div><div class="my-1 border-t border-slate-200"></div><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-700">You pay</dt><dd class="text-right font-mono font-semibold text-slate-900">3000 JPYC</dd></div></dl></div><p class="mt-3 text-[11px] leading-relaxed text-slate-500">OpenPay covers the network fee, so there is no charge to you (paid in JPYC, signature only).</p></section>"`;

