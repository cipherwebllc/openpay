exports[`PaymentForm — R14 内訳行 fixture (ja/en) > en > jpyc standard > closed 1`] = `"<section class="rounded-2xl border border-slate-200/70 bg-white p-5 shadow-card"><h2 class="text-sm font-semibold text-slate-700">Breakdown</h2><dl class="mt-3 space-y-2 text-sm"><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-500">Merchant receives</dt><dd class="text-right font-mono text-slate-700">300 JPYC</dd></div><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-500">Network fee</dt><dd class="text-right font-mono text-slate-700">Paid separately from your wallet</dd></div><div class="my-2 border-t border-slate-200"></div><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-700">You pay (+ wallet-side POL gas)</dt><dd class="text-right font-mono font-semibold text-slate-900">300 JPYC</dd></div></dl><p class="mt-4 text-xs text-slate-500">Standard payment: approve a single transfer in your wallet. Smart Account / Pimlico Paymaster is not used.</p></section>"`;

