exports[`TipForm — R14 内訳行 fixture (ja/en) > en > jpyc relay recover > closed 1`] = `"<section class="rounded-2xl border border-slate-200 bg-white p-4 text-sm"><p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Breakdown</p><dl class="mt-2 space-y-1.5"><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-500">Creator receives</dt><dd class="text-right font-mono text-slate-700">100 JPYC</dd></div><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-500">Estimated network fee<span class="relative inline-block"><button type="button" aria-label="Show details" aria-expanded="false" class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-slate-300 bg-white text-[10px] font-bold text-slate-500 hover:border-slate-400 hover:text-slate-700">?</button></span></dt><dd class="text-right font-mono text-slate-700">2 JPYC</dd></div><div class="my-1 border-t border-slate-200"></div><div class="flex justify-between gap-2"><dt class="inline-flex items-center gap-1 text-slate-700">You pay</dt><dd class="text-right font-mono font-semibold text-slate-900">102 JPYC</dd></div></dl><p class="mt-3 text-[11px] leading-relaxed text-slate-500">A per-transaction, gas-equivalent OpenPay usage fee applies (about 2 JPYC; the 1% does not apply to tips). The customer sending the tip bears it (signature only).</p></section>"`;

