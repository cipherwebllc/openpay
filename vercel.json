{
  "crons": [
    {
      "path": "/api/cron/reverify",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/store-reconcile",
      "schedule": "0 21 * * *"
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; else exit 0; fi",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "open-pay.jp" }],
      "missing": [{ "type": "header", "key": "cf-connecting-ip" }],
      "mitigate": { "action": "deny" }
    }
  ]
}
